# Production / server secrets for Docker MySQL (copy to deploy/.env — do NOT commit)
# 生产 / 服务器 Docker MySQL 密钥（复制为 deploy/.env，不要提交到 Git）
#
# cp deploy/.env.example deploy/.env
# Then keep backend/.env DATABASE_URL in sync with MYSQL_USER / MYSQL_PASSWORD.
# 并让 backend/.env 的 DATABASE_URL 与 MYSQL_USER / MYSQL_PASSWORD 一致
#
# --- MySQL user rules / MySQL 用户规则（官方 mysql:8 镜像）---
# MYSQL_ROOT_PASSWORD → root only / 仅用于 root
# MYSQL_USER + MYSQL_PASSWORD → regular app user (e.g. erp_admin), NOT root
# MYSQL_USER + MYSQL_PASSWORD → 普通应用用户（例如 erp_admin），不能是 root
#
# IMPORTANT: MYSQL_USER must NOT be "root" (and must not be empty).
# 重要：MYSQL_USER 不能设为 root（也不能为空）。
# If MYSQL_USER=root, the container fails with:
#   MYSQL_USER and MYSQL_PASSWORD are for configuring a regular user
#   and cannot be used for the root user
# 若 MYSQL_USER=root，容器会报上述错误并无法就绪。
# Demo default / 演示默认: MYSQL_USER=erp_admin, MYSQL_PASSWORD=erp_admin, root password=root

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=erp_demo
MYSQL_USER=erp_admin
MYSQL_PASSWORD=erp_admin
