# Production / server secrets for Docker MySQL (copy to deploy/.env — do NOT commit)
# 生产 / 服务器 Docker MySQL 密钥（复制为 deploy/.env，不要提交到 Git）
#
# cp deploy/.env.example deploy/.env
# 然后修改密码，并同步更新 backend/.env 里的 DATABASE_URL

MYSQL_ROOT_PASSWORD=erp_root_change_me
MYSQL_DATABASE=erp_demo
MYSQL_USER=erp
MYSQL_PASSWORD=erp_pass_change_me
