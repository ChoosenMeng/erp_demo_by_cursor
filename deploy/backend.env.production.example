# Backend production env example — copy to backend/.env on the server
# 后端生产环境示例 — 在服务器上复制为 backend/.env
#
# Replace YOUR_SERVER_IP with the IP you will use in the browser.
# 将 YOUR_SERVER_IP 换成浏览器访问用的服务器 IP。

APP_NAME=Cursor ERP Demo
APP_ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# User must match deploy/.env MYSQL_USER (erp), NOT root / 须与 MYSQL_USER=erp 一致，勿用 root
# Password must match MYSQL_PASSWORD / 密码须与 MYSQL_PASSWORD 一致
DATABASE_URL=mysql+pymysql://erp:erp_pass_change_me@127.0.0.1:3306/erp_demo?charset=utf8mb4
CORS_ORIGINS=http://YOUR_SERVER_IP
